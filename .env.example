# Issuer from the OIDC app, with no trailing slash.
# Discovery is {issuer}/.well-known/openid-configuration.
VITE_LR_ISSUER=https://your-app.hub.loginradius.com/service/oidc/YourApp

# Public client id. Do not put a client secret here.
VITE_LR_CLIENT_ID=

# Must match a redirect URI registered on the OIDC app.
VITE_LR_REDIRECT_URI=http://localhost:5173/callback

VITE_LR_SCOPES=openid profile email
